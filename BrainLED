#!/usr/bin/env python3

import time
import csv
import busio
from digitalio import DigitalInOut
import board
import adafruit_rfm9x
from gpiozero import RGBLED

# ================================
# RGB LED SETUP
# ================================
RED_PIN   = 16
GREEN_PIN = 20
BLUE_PIN  = 21

led = RGBLED(red=RED_PIN, green=GREEN_PIN, blue=BLUE_PIN, active_high=True)

def flash_color(color, flashes=3, on_time=0.5, off_time=0.2):
    """
    Triggers a background blink sequence. 
    Does not block the main loop.
    """
    led.blink(on_time=on_time, off_time=off_time, on_color=color, n=flashes, background=True)

# ================================
# LoRa CONFIG
# ================================
CS = DigitalInOut(board.CE1)
RESET = DigitalInOut(board.D25)
spi = busio.SPI(board.SCK, MOSI=board.MOSI, MISO=board.MISO)
rfm9x = adafruit_rfm9x.RFM9x(spi, CS, RESET, 915.0)

rfm9x.tx_power = 13
OUTPUT_CSV = "output.csv"

# LED COLORS
SEND_TO_2_COLOR  = (1, 1, 1)  # White
SEND_TO_34_COLOR = (1, 1, 0)  # Yellow

def process_incoming_messages(message: str):
    try:
        parts = message.strip().split(".")
        if len(parts) != 2: return None, None
        return parts[0], parts[1]
    except:
        return None, None

# STATE MACHINE
WAITING_FOR_GEO = "WAITING_FOR_GEO"
WAITING_FOR_CAMERA = "WAITING_FOR_CAMERA"
current_state = WAITING_FOR_GEO
CAMERA_TIMEOUT = 90
camera_wait_start = None
counter = 0

try:
    while True:
        packet = rfm9x.receive(timeout=1.0) # Lower timeout for more frequent checks

        if packet is None:
            if current_state == WAITING_FOR_CAMERA and camera_wait_start:
                if time.time() - camera_wait_start > CAMERA_TIMEOUT:
                    print("[BRAIN] CAMERA TIMEOUT")
                    current_state = WAITING_FOR_GEO
            continue

        msg = packet.decode("utf-8", errors="ignore").strip()
        device_id, data = process_incoming_messages(msg)
        if device_id is None: continue

        if data == "0":
            # RECEIVING 1.0 (Geophone)
            if current_state == WAITING_FOR_GEO and device_id == "1":
                print("[BRAIN] RECEIVED 1.0 (Geo)")
                flash_color((0, 1, 0)) # Green (Background)
                
                print("[BRAIN] SENDING 0.2 (Camera)")
                rfm9x.send("0.2".encode())
                flash_color(SEND_TO_2_COLOR) # White (Overrides Green)

                current_state = WAITING_FOR_CAMERA
                camera_wait_start = time.time()

            # RECEIVING 2.0 (Camera)
            elif current_state == WAITING_FOR_CAMERA and device_id == "2":
                print("[BRAIN] RECEIVED 2.0 (Camera)")
                flash_color((0, 0, 1)) # Blue
                
                print("[BRAIN] SENDING 0.34 (Deterrence)")
                rfm9x.send("0.34".encode())
                flash_color(SEND_TO_34_COLOR) # Yellow

                current_state = WAITING_FOR_GEO
                camera_wait_start = None

        counter += 1

except KeyboardInterrupt:
    print("\nStopping...")
finally:
    led.off()
