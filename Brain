import time
import csv
import busio
from digitalio import DigitalInOut
import board
import adafruit_rfm9x

# Configure LoRa Radio
CS = DigitalInOut(board.CE1)
RESET = DigitalInOut(board.D25)
spi = busio.SPI(board.SCK, MOSI=board.MOSI, MISO=board.MISO)
rfm9x = adafruit_rfm9x.RFM9x(spi, CS, RESET, 915.0)

def process_incoming_messages(message):
    try:
        print(f"Raw message: '{message}'")
        parts = message.strip().split('.')
        if len(parts) != 2:
            print("Invalid Message Format")
            return None, None
        else:
            device_id = parts[0]
            data = parts[1]
            return device_id, data
    except Exception as e:
        print(f"Error processing message: {e}")
        return None, None

# Receive messages from the LoRa module
counter = 0
while True:
    received_message = rfm9x.receive()
    if received_message is not None:
#added try to prevent decode errors.
     try:
      received_message_str = str(received_message, 'utf-8').strip()
      device_id, data = process_incoming_messages(received_message_str)
      with open('output.csv', mode='a', newline='') as file:
         csv.writer(file).writerow([device_id, data, counter])
#This exception block prevents crashes from non utf-8 decode attempts.
     except:
       recieved_message_str = str(received_message, 'latin-1', errors='ignore').strip
       print("Warning: Decode Fallback Used!")   

     if data == "0":
           
            if device_id == "1":
                time.sleep(10)
                rfm9x.send("0.2".encode())
                with open('output.csv', mode='a', newline='') as file:
                    csv.writer(file).writerow([0, 34, counter])
                print("Geophone Detection Message Received, Camera Detection Message Sent!")
            if device_id == "2":
                time.sleep(10)
                rfm9x.send("0.34".encode())
                with open('output.csv', mode='a', newline='') as file:
                    csv.writer(file).writerow([0, 34, counter])
                print("Camera Detection Message Received, Deterrence Message Sent to Lights and Thumper")
                    
    else:
       time.sleep(0.1)
